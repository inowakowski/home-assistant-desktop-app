<!--
    KDE Plasma 6 with Breeze: KWin draws the title bar, the sidebar and the page sit on Breeze's colours, the
    open page is marked with a light fill and an outline in Breeze blue, and everything is a little denser.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HadaWindowBrush" Color="#202326" />
                    <SolidColorBrush x:Key="HadaSidebarBrush" Color="#202326" />
                    <SolidColorBrush x:Key="HadaContentBrush" Color="#141618" />
                    <SolidColorBrush x:Key="HadaContentStrokeBrush" Color="#2E3236" />
                    <SolidColorBrush x:Key="HadaHeaderBrush" Color="#292C30" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#1D2023" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#232629" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="#2E3236" />
                    <SolidColorBrush x:Key="HadaSeparatorBrush" Color="#2E3236" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#292C30" />
                    <SolidColorBrush x:Key="HadaPrimaryTextBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#A1A9B1" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#7F8C8D" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaNavHoverBrush" Color="#1A3DAEE9" />
                    <SolidColorBrush x:Key="HadaNavSelectedBrush" Color="#333DAEE9" />
                    <SolidColorBrush x:Key="HadaNavSelectedTextBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="HadaNavSelectedBorderBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaIndicatorBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaAvatarBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaAvatarIconBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HadaWindowBrush" Color="#EFF0F1" />
                    <SolidColorBrush x:Key="HadaSidebarBrush" Color="#EFF0F1" />
                    <SolidColorBrush x:Key="HadaContentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaContentStrokeBrush" Color="#D1D5D9" />
                    <SolidColorBrush x:Key="HadaHeaderBrush" Color="#DEE0E2" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#F4F5F6" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="#D1D5D9" />
                    <SolidColorBrush x:Key="HadaSeparatorBrush" Color="#D1D5D9" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#EFF0F1" />
                    <SolidColorBrush x:Key="HadaPrimaryTextBrush" Color="#232629" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#707D8A" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#8D9AA6" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaNavHoverBrush" Color="#1A3DAEE9" />
                    <SolidColorBrush x:Key="HadaNavSelectedBrush" Color="#333DAEE9" />
                    <SolidColorBrush x:Key="HadaNavSelectedTextBrush" Color="#232629" />
                    <SolidColorBrush x:Key="HadaNavSelectedBorderBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaIndicatorBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaAvatarBrush" Color="#3DAEE9" />
                    <SolidColorBrush x:Key="HadaAvatarIconBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Plasma's font, then Inter where it is missing.  -->
            <FontFamily x:Key="HadaFontFamily">Noto Sans, fonts:Inter#Inter</FontFamily>
            <x:Double x:Key="HadaBodySize">13.3</x:Double>
            <x:Double x:Key="HadaTitleSize">20</x:Double>
            <x:Double x:Key="HadaSubtitleSize">16</x:Double>
            <x:Double x:Key="HadaCaptionSize">11.5</x:Double>
            <x:Double x:Key="HadaSidebarWidth">250</x:Double>
            <x:Double x:Key="HadaHeaderHeight">42</x:Double>
            <CornerRadius x:Key="HadaCardCorner">5</CornerRadius>
            <CornerRadius x:Key="HadaNavCorner">3</CornerRadius>
            <CornerRadius x:Key="HadaContentCorner">0</CornerRadius>
            <Thickness x:Key="HadaContentBorder">1,0,0,0</Thickness>
            <Thickness x:Key="HadaPageMargin">20,16,20,20</Thickness>
            <Thickness x:Key="HadaNavItemPadding">8,6</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!--  The page's title is in the header above it, as in Plasma's System Settings.  -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  The header has a line under it.  -->
    <Style Selector="Border#ContentHeader">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaSeparatorBrush}" />
    </Style>
</Styles>
