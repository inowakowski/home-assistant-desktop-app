<!--
    GNOME, as libadwaita draws its apps: a sidebar and a content pane, each with a flat header bar on top, the
    page title centred in it and only a close button; boxed lists with round corners; Adwaita's colours.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HadaWindowBrush" Color="#222226" />
                    <SolidColorBrush x:Key="HadaSidebarBrush" Color="#2E2E32" />
                    <SolidColorBrush x:Key="HadaContentBrush" Color="#222226" />
                    <SolidColorBrush x:Key="HadaContentStrokeBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HadaHeaderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HadaSeparatorBrush" Color="#5C000006" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="HadaPrimaryTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#78AEED" />
                    <SolidColorBrush x:Key="HadaNavHoverBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="HadaNavSelectedBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="HadaNavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaNavSelectedBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HadaIndicatorBrush" Color="#3584E4" />
                    <SolidColorBrush x:Key="HadaAvatarBrush" Color="#3584E4" />
                    <SolidColorBrush x:Key="HadaAvatarIconBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HadaWindowBrush" Color="#FAFAFB" />
                    <SolidColorBrush x:Key="HadaSidebarBrush" Color="#EBEBED" />
                    <SolidColorBrush x:Key="HadaContentBrush" Color="#FAFAFB" />
                    <SolidColorBrush x:Key="HadaContentStrokeBrush" Color="#1F000006" />
                    <SolidColorBrush x:Key="HadaHeaderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#F4F4F6" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="#12000006" />
                    <SolidColorBrush x:Key="HadaSeparatorBrush" Color="#12000006" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#0F000006" />
                    <SolidColorBrush x:Key="HadaPrimaryTextBrush" Color="#CC000006" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#8C000006" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#66000006" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#1C71D8" />
                    <SolidColorBrush x:Key="HadaNavHoverBrush" Color="#0F000006" />
                    <SolidColorBrush x:Key="HadaNavSelectedBrush" Color="#1A000006" />
                    <SolidColorBrush x:Key="HadaNavSelectedTextBrush" Color="#CC000006" />
                    <SolidColorBrush x:Key="HadaNavSelectedBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HadaIndicatorBrush" Color="#3584E4" />
                    <SolidColorBrush x:Key="HadaAvatarBrush" Color="#3584E4" />
                    <SolidColorBrush x:Key="HadaAvatarIconBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  GNOME's own font, then its predecessor, then Inter, which GNOME's font is made from.  -->
            <FontFamily x:Key="HadaFontFamily">Adwaita Sans, Cantarell, fonts:Inter#Inter</FontFamily>
            <x:Double x:Key="HadaBodySize">14.5</x:Double>
            <x:Double x:Key="HadaTitleSize">26</x:Double>
            <x:Double x:Key="HadaSubtitleSize">15</x:Double>
            <x:Double x:Key="HadaCaptionSize">12.5</x:Double>
            <x:Double x:Key="HadaSidebarWidth">270</x:Double>
            <x:Double x:Key="HadaHeaderHeight">47</x:Double>
            <CornerRadius x:Key="HadaCardCorner">12</CornerRadius>
            <CornerRadius x:Key="HadaNavCorner">6</CornerRadius>
            <CornerRadius x:Key="HadaContentCorner">0</CornerRadius>
            <Thickness x:Key="HadaContentBorder">0</Thickness>
            <Thickness x:Key="HadaPageMargin">32,12,32,32</Thickness>
            <Thickness x:Key="HadaNavItemPadding">12,10</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!--  The page's title is in the header bar.  -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  Headings above boxed lists are small and bold.  -->
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Boxed lists stand out by a faint shadow in the light style, by their fill in the dark one.  -->
    <Style Selector="Border.card">
        <Setter Property="BoxShadow" Value="0 1 3 0 #12000006" />
    </Style>
    <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 1 3 0 #12000006" />
    </Style>
</Styles>
