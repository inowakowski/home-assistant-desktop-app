<!--
    What every style shares. The colours, fonts and sizes come from the style of the system, Themes/*.axaml,
    which also changes what that system does differently.
-->
<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.Avalonia">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HadaErrorTextBrush" Color="#FFB3BB" />
                    <SolidColorBrush x:Key="HadaWarningIconBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="HadaSuccessIconBrush" Color="#6CCB5F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HadaErrorTextBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HadaWarningIconBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="HadaSuccessIconBrush" Color="#0F7B0F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource HadaFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource HadaBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>

    <!--  Text  -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource HadaTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource HadaSubtitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource HadaCaptionSize}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource HadaSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource HadaTertiaryTextBrush}" />
    </Style>
    <!--  Times and traces in the logs: the system's monospaced font.  -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, SF Mono, DejaVu Sans Mono, Noto Sans Mono, monospace" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource HadaErrorTextBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="18,14,18,6" />
    </Style>
    <Style Selector="TextBlock.headerTitle">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  A card: a raised area on the page, also as a button that leads somewhere.  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource HadaCardCorner}" />
    </Style>
    <Style Selector="Button.card">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource HadaCardCorner}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaSecondaryTextBrush}" />
    </Style>

    <!--  A row of a settings section, a FieldRow: what it is on the left, the field on the right.  -->
    <Style Selector="Grid.field">
        <Setter Property="Margin" Value="18,8" />
    </Style>
    <Style Selector="Grid.field > TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  A message: what happened, coloured by how it is to be taken.  -->
    <Style Selector="Border.message">
        <Setter Property="CornerRadius" Value="{DynamicResource HadaCardCorner}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!--  A list row that is a button: the whole row is clickable.  -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaCardHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>

    <!--  A plain button that reads like a link, as in a breadcrumb.  -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource HadaAttentionBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HadaAttentionBrush}" />
    </Style>

    <!--  A way to connect, offered when one is added; the chosen one is outlined in the accent colour.  -->
    <Style Selector="Button.option">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource HadaCardCorner}" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.option.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource HadaIndicatorBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.option.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource HadaIndicatorBrush}" />
    </Style>

    <!--  The steps of adding a connection.  -->
    <Style Selector="Border.stepNumber">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaTertiaryTextBrush}" />
    </Style>
    <Style Selector="Border.stepNumber.current">
        <Setter Property="Background" Value="{DynamicResource HadaIndicatorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaIndicatorBrush}" />
    </Style>

    <!--  The sidebar, and the same collapsed to its icons.  -->
    <Style Selector="Border#Sidebar">
        <Setter Property="Width" Value="{DynamicResource HadaSidebarWidth}" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed">
        <Setter Property="Width" Value="76" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed TextBlock.navText">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  The rounded tile behind an icon.  -->
    <Style Selector="Border.iconTile">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource HadaTileBrush}" />
    </Style>

    <!--  A row of a table or boxed list, with a line above it; dimmed for an entity that is switched off.  -->
    <Style Selector="Border.tableRow">
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaSeparatorBrush}" />
    </Style>
    <Style Selector="Border.tableRow.disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--  One setting: what it is on the left, its control on the right, a line between it and the next.  -->
    <Style Selector="Border.settingRow">
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaSeparatorBrush}" />
    </Style>
    <Style Selector="Border.settingRow.last">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  A row of the list of entities, with a line between rows.  -->
    <Style Selector="Border.entityRow">
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaSeparatorBrush}" />
    </Style>
    <Style Selector="ContentPresenter:nth-last-child(1) > Border.entityRow">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  The computer at the top of the sidebar.  -->
    <Style Selector="Border.avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource HadaAvatarBrush}" />
    </Style>

    <!--  The navigation: the open page is filled; the accent bar and the coloured tiles are for the styles that use them.  -->
    <Style Selector="ListBox.navigation">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource HadaNavItemPadding}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{DynamicResource HadaNavCorner}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaNavSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaNavSelectedTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaNavSelectedBorderBrush}" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaNavSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaNavSelectedTextBrush}" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaNavSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HadaNavSelectedTextBrush}" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaNavSelectedBrush}" />
    </Style>
    <Style Selector="Border.indicator">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="-9,0,6,0" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HadaIndicatorBrush}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.navTile">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fi|FluentIcon.navIcon">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!--  Window buttons HADA draws itself, where the system draws none or HADA shows another system's style.  -->
    <Style Selector="Button.chrome">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HadaPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.chrome.windows">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.chrome.windows.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chrome.gnome">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource HadaTileBrush}" />
    </Style>
    <Style Selector="Button.chrome.kde">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Button.chrome.kde.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#DA4453" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
