<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HadaPaneBrush" Color="#202020" />
                    <SolidColorBrush x:Key="HadaPageBrush" Color="#272727" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#323232" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#60CDFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HadaPaneBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="HadaPageBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="HadaCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HadaCardHoverBrush" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="HadaStrokeBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="HadaTileBrush" Color="#EDEDED" />
                    <SolidColorBrush x:Key="HadaSecondaryTextBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="HadaTertiaryTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="HadaAttentionBrush" Color="#005FB8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--  Text  -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource HadaSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource HadaTertiaryTextBrush}" />
    </Style>

    <!--  A card: a raised area on the page, also as a button that leads somewhere.  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.card">
        <Setter Property="Background" Value="{DynamicResource HadaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HadaCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
    </Style>

    <!--  The rounded tile behind an icon.  -->
    <Style Selector="Border.iconTile">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource HadaTileBrush}" />
    </Style>

    <!--  A row of a table, with a line above it.  -->
    <Style Selector="Border.tableRow">
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource HadaStrokeBrush}" />
    </Style>
    <Style Selector="Border.tableRow.disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--  The navigation on the left.  -->
    <Style Selector="ListBox.navigation">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</Styles>
