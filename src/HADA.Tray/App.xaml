<!--
    No resources here: the tray role never shows a window, so the control library and the styles are loaded in code,
    by the window role only (App.StartWindow).
-->
<Application
    x:Class="HADA.Tray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnExplicitShutdown" />
