<Page
    x:Class="HADA.Tray.Views.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HADA.Tray.Views.Controls"
    xmlns:l="clr-namespace:HADA.Tray.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Nav_Connections}"
    Style="{StaticResource HadaPage}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SaveBar Grid.Row="1" DataContext="{Binding Settings}" />
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="28,8,28,28">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Connections_Title}" />
            <ui:TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:Tr Connections_Subtitle}"
                TextWrapping="Wrap" />

            <ui:Card
                Margin="0,0,0,12"
                Padding="16,12"
                Visibility="{Binding Settings.IsLocked, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="ShieldLock24" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,16,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_LockedTitle}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{l:Tr Settings_LockedMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding UnlockCommand}"
                        Content="{l:Tr Common_Unlock}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <StackPanel DataContext="{Binding Settings}">
                <!--  MQTT: one server per Home Assistant, all connected at once; the form shows the selected one.  -->
                <ui:Card
                    x:Name="MqttCard"
                    Margin="0,0,0,12"
                    Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <ui:SymbolIcon FontSize="22" Symbol="Router24" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,16,0"
                                VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Subtitle" Text="MQTT" />
                                <ui:TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{l:Tr Mqtt_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:ProgressRing
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,12,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsTestingMqtt, Converter={StaticResource BooleanToVisibility}}" />
                                <ui:Button Command="{Binding TestMqttCommand}" Content="{l:Tr Test_Button}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PlugConnected24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!--  The servers, as tabs; with only one there is nothing to choose, just the way to add another.  -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                x:Name="MqttServerList"
                                Margin="0,0,16,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding MqttServers}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedMqttServer}"
                                Visibility="{Binding HasSeveralMqttServers, Converter={StaticResource BooleanToVisibility}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="Home24" />
                                            <ui:TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:Tr Mqtt_OneServer}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasOneMqttServer, Converter={StaticResource BooleanToVisibility}}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <ui:Button Command="{Binding AddMqttServerCommand}" Content="{l:Tr Mqtt_AddServer}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding RemoveMqttServerCommand}"
                                    Content="{l:Tr Mqtt_RemoveServer}"
                                    Visibility="{Binding HasSeveralMqttServers, Converter={StaticResource BooleanToVisibility}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar
                            Title="{Binding MqttTest.Title}"
                            Margin="0,16,0,0"
                            IsOpen="{Binding MqttTest.IsOpen, Mode=TwoWay}"
                            Message="{Binding MqttTest.Message}"
                            Severity="{Binding MqttTest.Severity}" />

                        <Grid
                            Margin="0,18,0,0"
                            DataContext="{Binding SelectedMqttServer}"
                            IsEnabled="{Binding DataContext.CanEdit, ElementName=MqttCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_ServerName}" />
                                <ui:TextBox PlaceholderText="{l:Tr Placeholder_ServerName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <ui:TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,22,0,14"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                Text="{l:Tr Mqtt_ServerNameHint}"
                                TextWrapping="Wrap" />

                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_Host}" />
                                <ui:TextBox PlaceholderText="homeassistant.local" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock
                                        Margin="0,0,0,6"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Field_Port}" />
                                    <ui:NumberBox
                                        MaxDecimalPlaces="0"
                                        Maximum="65535"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <ui:TextBlock
                                        Margin="0,0,0,6"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Field_UseTls}" />
                                    <ui:ToggleSwitch
                                        Margin="0,6,0,0"
                                        IsChecked="{Binding UseTls}"
                                        OffContent="{l:Tr Common_Off}"
                                        OnContent="{l:Tr Common_On}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_Username}" />
                                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_Password}" />
                                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding PasswordPlaceholder}" />
                                <CheckBox
                                    Margin="0,6,0,0"
                                    Content="{l:Tr Field_ClearSecret}"
                                    IsChecked="{Binding ClearPassword}"
                                    Visibility="{Binding HasPassword, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_DeviceId}" />
                                <ui:TextBox PlaceholderText="{Binding MachineNamePlaceholder}" Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_DeviceName}" />
                                <ui:TextBox PlaceholderText="{Binding MachineNamePlaceholder}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Expander
                                Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Header="{l:Tr Field_Advanced}">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock
                                            Margin="0,0,0,6"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            FontTypography="Caption"
                                            Text="{l:Tr Field_DiscoveryPrefix}" />
                                        <ui:TextBox Text="{Binding DiscoveryPrefix, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock
                                            Margin="0,0,0,6"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            FontTypography="Caption"
                                            Text="{l:Tr Field_BaseTopic}" />
                                        <ui:TextBox Text="{Binding BaseTopic, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  Home Assistant WebSocket  -->
                <ui:Card
                    x:Name="HomeAssistantCard"
                    Margin="0,0,0,12"
                    Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <ui:SymbolIcon FontSize="22" Symbol="HomeCheckmark24" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,16,0"
                                VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Subtitle" Text="Home Assistant (WebSocket)" />
                                <ui:TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{l:Tr Ha_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:ProgressRing
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,12,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsTestingHomeAssistant, Converter={StaticResource BooleanToVisibility}}" />
                                <ui:Button Command="{Binding TestHomeAssistantCommand}" Content="{l:Tr Test_Button}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PlugConnected24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!--  The Home Assistants, as tabs, like the MQTT servers above.  -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                Margin="0,0,16,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding HomeAssistantServers}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedHomeAssistantServer}"
                                Visibility="{Binding HasSeveralHomeAssistantServers, Converter={StaticResource BooleanToVisibility}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="Home24" />
                                            <ui:TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:Tr Mqtt_OneServer}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasOneHomeAssistantServer, Converter={StaticResource BooleanToVisibility}}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <ui:Button Command="{Binding AddHomeAssistantServerCommand}" Content="{l:Tr Mqtt_AddServer}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding RemoveHomeAssistantServerCommand}"
                                    Content="{l:Tr Mqtt_RemoveServer}"
                                    Visibility="{Binding HasSeveralHomeAssistantServers, Converter={StaticResource BooleanToVisibility}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar
                            Title="{Binding HomeAssistantTest.Title}"
                            Margin="0,16,0,0"
                            IsOpen="{Binding HomeAssistantTest.IsOpen, Mode=TwoWay}"
                            Message="{Binding HomeAssistantTest.Message}"
                            Severity="{Binding HomeAssistantTest.Severity}" />

                        <Grid
                            Margin="0,18,0,0"
                            DataContext="{Binding SelectedHomeAssistantServer}"
                            IsEnabled="{Binding DataContext.CanEdit, ElementName=HomeAssistantCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_ServerName}" />
                                <ui:TextBox PlaceholderText="{l:Tr Placeholder_ServerName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <ui:TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,22,0,14"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                Text="{l:Tr Mqtt_ServerNameHint}"
                                TextWrapping="Wrap" />

                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_BaseUrl}" />
                                <ui:TextBox PlaceholderText="http://homeassistant.local:8123" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_AccessToken}" />
                                <ui:PasswordBox Password="{Binding AccessToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding AccessTokenPlaceholder}" />
                                <CheckBox
                                    Margin="0,6,0,0"
                                    Content="{l:Tr Field_ClearSecret}"
                                    IsChecked="{Binding ClearAccessToken}"
                                    Visibility="{Binding HasAccessToken, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_DeviceId}" />
                                <ui:TextBox PlaceholderText="{Binding MachineNamePlaceholder}" Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_DeviceName}" />
                                <ui:TextBox PlaceholderText="{Binding MachineNamePlaceholder}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  What this connection is used for.  -->
                            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_HaNotifications}" />
                                <ui:ToggleSwitch
                                    IsChecked="{Binding Notifications}"
                                    OffContent="{l:Tr Common_Off}"
                                    OnContent="{l:Tr Common_On}" />
                                <ui:TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Ha_NotificationsHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="0,0,0,14">
                                <ui:TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Field_HaSensors}" />
                                <ComboBox
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding SensorModes}"
                                    SelectedValue="{Binding SensorMode}"
                                    SelectedValuePath="Mode" />
                                <ui:TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontTypography="Caption"
                                    Text="{l:Tr Ha_SensorsHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Expander
                                Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Header="{l:Tr Field_Advanced}">
                                <StackPanel Margin="0,12,0,0">
                                    <ui:TextBlock
                                        Margin="0,0,0,6"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Field_CommandEventType}" />
                                    <ui:TextBox Text="{Binding CommandEventType, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
