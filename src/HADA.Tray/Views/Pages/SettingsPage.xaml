<Page
    x:Class="HADA.Tray.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HADA.Tray.Views.Controls"
    xmlns:l="clr-namespace:HADA.Tray.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Nav_Settings}"
    Style="{StaticResource HadaPage}">
    <Page.Resources>
        <!--  One setting: what it is on the left, its control on the right, a line between it and the next.  -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SaveBar Grid.Row="1" DataContext="{Binding Settings}" />
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" Margin="28,8,28,28">
                <ui:TextBlock FontTypography="Title" Text="{l:Tr Preferences_Title}" />
                <ui:TextBlock
                    Margin="0,4,0,16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{l:Tr Preferences_Subtitle}"
                    TextWrapping="Wrap" />

                <!--  Updates  -->
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Subtitle"
                    Text="{l:Tr Preferences_Updates}" />
                <ui:Card Margin="0,0,0,12" Padding="0">
                    <StackPanel>
                        <Border DataContext="{Binding Updates}" Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border VerticalAlignment="Center" Style="{StaticResource IconTile}">
                                    <ui:SymbolIcon FontSize="22" Symbol="ArrowSync24" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="14,0,16,0"
                                    VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding InstalledVersionText}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Margin="0,4,8,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Height" Value="10" />
                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CheckKind}" Value="Success">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CheckKind}" Value="Warning">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CheckKind}" Value="Error">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <ui:TextBlock
                                            Grid.Column="1"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CheckStatus}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{Binding CheckNowCommand}"
                                    Content="{l:Tr Preferences_CheckNow}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!--  The same notice as on the Overview page, when there is something to install.  -->
                        <Border
                            DataContext="{Binding Updates}"
                            Style="{StaticResource SettingRow}"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border VerticalAlignment="Center" Style="{StaticResource IconTile}">
                                    <ui:SymbolIcon
                                        FontSize="22"
                                        Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                        Symbol="ArrowDownload24" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="14,0,16,0"
                                    VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        Height="4"
                                        Margin="0,8,0,0"
                                        Maximum="1"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}"
                                        Value="{Binding Progress, Mode=OneWay}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenReleasePageCommand}"
                                    Content="{l:Tr Update_Open}" />
                                <ui:Button
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Appearance="Primary"
                                    Command="{Binding InstallCommand}"
                                    Content="{l:Tr Update_Install}"
                                    Visibility="{Binding CanInstall, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Preferences_AutoCheck}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Preferences_AutoCheckDetail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Settings.CheckUpdatesAutomatically}"
                                    IsEnabled="{Binding Settings.CanEdit}"
                                    OffContent="{l:Tr Common_Off}"
                                    OnContent="{l:Tr Common_On}" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Preferences_Prereleases}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Preferences_PrereleasesDetail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Settings.IncludePrereleases}"
                                    IsEnabled="{Binding Settings.CanEdit}"
                                    OffContent="{l:Tr Common_Off}"
                                    OnContent="{l:Tr Common_On}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!--  The two switches above belong to the service, so changing them takes an administrator.  -->
                <ui:Card
                    Margin="0,0,0,12"
                    Padding="16,12"
                    Visibility="{Binding Settings.IsLocked, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Symbol="ShieldLock24" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,16,0"
                            VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_LockedTitle}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:Tr Preferences_LockedMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Appearance="Primary"
                            Command="{Binding UnlockCommand}"
                            Content="{l:Tr Common_Unlock}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!--  Personal  -->
                <ui:TextBlock
                    Margin="0,12,0,2"
                    FontTypography="Subtitle"
                    Text="{l:Tr Preferences_Personal}" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Preferences.Note}"
                    TextWrapping="Wrap" />
                <ui:Card Padding="0" DataContext="{Binding Preferences}">
                    <StackPanel IsEnabled="{Binding CanChange}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Autostart_Title}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Autostart_Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding StartWithWindows}"
                                    OffContent="{l:Tr Common_Off}"
                                    OnContent="{l:Tr Common_On}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Preferences_Language}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Preferences_LanguageDetail}"
                                        TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Preferences_LanguageRestart}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsLanguageChanged, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding Languages}"
                                    SelectedValue="{Binding Language}"
                                    SelectedValuePath="Code" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Preferences_Idle}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        Text="{l:Tr Preferences_IdleDetail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:NumberBox
                                    Grid.Column="1"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    MaxDecimalPlaces="0"
                                    Maximum="{Binding MaxIdleSeconds}"
                                    Minimum="{Binding MinIdleSeconds}"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding IdleSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
