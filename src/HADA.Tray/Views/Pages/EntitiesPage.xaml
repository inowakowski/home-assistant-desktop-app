<Page
    x:Class="HADA.Tray.Views.Pages.EntitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HADA.Tray.Views.Controls"
    xmlns:l="clr-namespace:HADA.Tray.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Nav_Entities}"
    Style="{StaticResource HadaPage}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SaveBar Grid.Row="1" DataContext="{Binding Settings}" />
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="28,8,28,28">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Entities_Title}" />
            <ui:TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:Tr Entities_Subtitle}"
                TextWrapping="Wrap" />

            <ui:Card
                Margin="0,0,0,12"
                Padding="16,12"
                Visibility="{Binding Settings.IsLocked, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="ShieldLock24" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,16,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_LockedTitle}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{l:Tr Settings_LockedMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding UnlockCommand}"
                        Content="{l:Tr Common_Unlock}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <ui:Card Padding="0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Entities.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="18,12"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border VerticalAlignment="Center" Style="{StaticResource IconTile}">
                                            <ui:SymbolIcon FontSize="20" Symbol="{Binding Symbol}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,16,0"
                                            VerticalAlignment="Center">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <ui:TextBlock
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                FontTypography="Caption"
                                                Text="{Binding Caption}" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                FontTypography="Caption"
                                                Text="{Binding Hint}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibility}}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsEnabled}"
                                            IsEnabled="{Binding DataContext.Settings.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}"
                                            OffContent="{l:Tr Common_Off}"
                                            OnContent="{l:Tr Common_On}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock
                        Margin="18,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr Entities_Empty}"
                        Visibility="{Binding Entities.HasNoEntities, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
