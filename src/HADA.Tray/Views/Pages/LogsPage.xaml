<Page
    x:Class="HADA.Tray.Views.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:HADA.Tray.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:Tr Nav_Logs}"
    Style="{StaticResource HadaPage}">
    <Grid Margin="28,8,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Logs_Title}" />
            <ui:TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:Tr Logs_Subtitle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="0,0,0,12"
            DataContext="{Binding Logs}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:Tr Logs_Level}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="170"
                Margin="12,0,0,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding LevelOptions}"
                SelectedItem="{Binding MinimumLevel}" />
            <CheckBox
                Grid.Column="3"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Content="{l:Tr Logs_AutoScroll}"
                IsChecked="{Binding AutoScroll}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ui:Button Command="{Binding CopyCommand}" Content="{l:Tr Logs_Copy}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding ClearCommand}"
                    Content="{l:Tr Logs_Clear}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ui:Card
            Grid.Row="2"
            Padding="0"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid DataContext="{Binding Logs}">
                <ItemsControl
                    x:Name="LogList"
                    ItemsSource="{Binding View}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer
                                x:Name="LogScroll"
                                Padding="0,6"
                                CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Smaller than the message: monospaced digits look heavier than the text font at the same size.  -->
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontFamily="Cascadia Mono, Consolas, Courier New"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Time}" />
                                <Border
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource LogLevelBadge}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding LevelText}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,12,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Category}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FullCategory}" />
                                <StackPanel Grid.Column="3">
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Cascadia Mono, Consolas, Courier New"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ExceptionText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasException, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock
                    Margin="18,16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{l:Tr Logs_Empty}"
                    Visibility="{Binding HasNoEntries, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
