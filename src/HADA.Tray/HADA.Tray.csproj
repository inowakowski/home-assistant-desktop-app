<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version gives access to the Windows Runtime, which the media playback sensor reads.
         The app still starts on any Windows 10 from 1809 on. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Shown by Windows as the sender of notifications. -->
    <AssemblyTitle>HADA</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: WPF has no notification-area icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\hada.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the window and the notification area, loaded as /Assets/hada.ico. -->
    <Resource Include="..\..\assets\hada.ico" Link="Assets\hada.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF type names such as Application unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.20" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HADA.Core\HADA.Core.csproj" />
    <ProjectReference Include="..\HADA.Ipc\HADA.Ipc.csproj" />
    <ProjectReference Include="..\HADA.Platform.Windows\HADA.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
