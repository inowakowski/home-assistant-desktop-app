<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <!--
        The UpgradeCode identifies HADA across versions and must never change: it is how a newer installer finds
        and replaces an older installation.
    -->
    <Package
        Name="HADA – Home Assistant Desktop App"
        Manufacturer="Ignacy Nowakowski"
        Version="$(var.ProductVersion)"
        UpgradeCode="6C0C1B5E-3C1B-4E57-9B0B-7C2B3F0D9A41"
        Scope="perMachine"
        Compressed="yes">

        <!-- Installing again replaces what is there, also with the same version, which makes test builds easy to update. -->
        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of HADA is already installed. Remove it first to install this older one." />
        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

        <!-- The .exe ending is required for the icon of an advertised shortcut to an .exe. -->
        <Icon Id="HadaIcon.exe" SourceFile="$(var.IconFile)" />
        <Property Id="ARPPRODUCTICON" Value="HadaIcon.exe" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/inowakowski/home-assistant-desktop-app" />

        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="HADA">
                <Directory Id="ServiceFolder" Name="service" />
                <Directory Id="TrayFolder" Name="tray" />
                <Directory Id="AppFolder" Name="app" />
            </Directory>
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder" />

        <Feature Id="Main" Title="HADA">
            <ComponentRef Id="InstallFolderPermissions" />
            <ComponentGroupRef Id="ServiceFiles" />
            <ComponentGroupRef Id="TrayFiles" />
            <ComponentGroupRef Id="AppFiles" />
        </Feature>

        <!--
            The service runs as SYSTEM from this folder, so nobody but the system and the administrators may change
            what is in it. Program Files grants no more than that, but a folder named on the command line
            (INSTALLFOLDER=…) would inherit the rights of wherever it is, and on a drive's root every signed-in user
            may change what is in a new folder. So the folder gets rights of its own, not inherited: full control for
            the system and the administrators, reading and running for users and for apps from the Store, as in
            Program Files. What is installed below it inherits them.
        -->
        <Component Id="InstallFolderPermissions" Directory="INSTALLFOLDER" Guid="3F9C2A71-6B4E-4D8A-9E25-71C0B8D4A6F3">
            <CreateFolder>
                <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;AC)" />
            </CreateFolder>
        </Component>

        <ComponentGroup Id="ServiceFiles" Directory="ServiceFolder">
            <Component Id="ServiceExe">
                <File Id="ServiceExeFile" Source="$(var.ServiceDir)\HADA.Service.exe" KeyPath="yes" />

                <!-- Runs as LocalSystem and starts with Windows, so the computer shows up in Home Assistant before anyone signs in. -->
                <ServiceInstall
                    Id="HadaService"
                    Name="HADA"
                    DisplayName="Home Assistant Desktop App"
                    Description="Reports this computer to Home Assistant and runs its commands."
                    Type="ownProcess"
                    Start="auto"
                    ErrorControl="normal"
                    Account="LocalSystem">
                    <!-- Restart a minute after a crash; the failure count starts over each day. -->
                    <util:ServiceConfig
                        FirstFailureActionType="restart"
                        SecondFailureActionType="restart"
                        ThirdFailureActionType="restart"
                        RestartServiceDelayInSeconds="60"
                        ResetPeriodInDays="1" />
                </ServiceInstall>
                <ServiceControl
                    Id="HadaServiceControl"
                    Name="HADA"
                    Start="install"
                    Stop="both"
                    Remove="uninstall"
                    Wait="yes" />
            </Component>

            <Files Include="$(var.ServiceDir)\**">
                <Exclude Files="$(var.ServiceDir)\HADA.Service.exe" />
            </Files>
        </ComponentGroup>

        <ComponentGroup Id="TrayFiles" Directory="TrayFolder">
            <Component Id="TrayExe">
                <File Id="TrayExeFile" Source="$(var.TrayDir)\HADA.Tray.exe" KeyPath="yes">
                    <Shortcut
                        Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="HADA"
                        Description="Home Assistant Desktop App: status and settings"
                        WorkingDirectory="TrayFolder"
                        Icon="HadaIcon.exe"
                        Advertise="yes" />
                </File>

                <!--
                    Starts the tray app, without its window, when any user signs in. With the autostart argument the
                    tray exits again if its user turned "Start with Windows" off in the HADA window.
                -->
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Microsoft\Windows\CurrentVersion\Run"
                    Name="HADA.Tray"
                    Type="string"
                    Value="&quot;[#TrayExeFile]&quot; --background --autostart" />
            </Component>

            <Files Include="$(var.TrayDir)\**">
                <Exclude Files="$(var.TrayDir)\HADA.Tray.exe" />
            </Files>
        </ComponentGroup>

        <!-- The new window, drawn with Avalonia: a preview beside the tray's own window, with a shortcut of its own. -->
        <ComponentGroup Id="AppFiles" Directory="AppFolder">
            <Component Id="AppExe">
                <File Id="AppExeFile" Source="$(var.AppDir)\HADA.App.exe" KeyPath="yes">
                    <Shortcut
                        Id="AppStartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="HADA (new window, preview)"
                        Description="The new HADA window, a preview"
                        WorkingDirectory="AppFolder"
                        Icon="HadaIcon.exe"
                        Advertise="yes" />
                </File>
            </Component>

            <Files Include="$(var.AppDir)\**">
                <Exclude Files="$(var.AppDir)\HADA.App.exe" />
            </Files>
        </ComponentGroup>

        <!-- The tray app and the windows hold files open; close them before files are replaced or removed. -->
        <util:CloseApplication
            Id="CloseTray"
            Target="HADA.Tray.exe"
            CloseMessage="no"
            RebootPrompt="no"
            TerminateProcess="0" />
        <util:CloseApplication
            Id="CloseApp"
            Target="HADA.App.exe"
            CloseMessage="no"
            RebootPrompt="no"
            TerminateProcess="0" />

        <!--
            Welcome, then install. The licence page of the stock dialog set is skipped, as there is no licence text to
            show, and so is the page for choosing a folder: HADA always goes to Program Files, whose rights keep its
            files out of ordinary users' reach. An administrator who must have it elsewhere can still pass
            INSTALLFOLDER on the command line, and the folder is then given the same rights (see above).
        -->
        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
        <UI>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="99" Condition="NOT Installed" />
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" Condition="NOT Installed" />

            <!--
                Offered on the last page. The action runs in the installer's user interface process, so the tray
                starts as the signed-in user and not with the installer's administrator rights.
            -->
            <Publish
                Dialog="ExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchTray"
                Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
        </UI>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start HADA and open its window" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="WixShellExecTarget" Value="[#TrayExeFile]" />
        <CustomAction
            Id="LaunchTray"
            BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
            DllEntry="WixShellExec"
            Impersonate="yes" />
    </Package>
</Wix>
